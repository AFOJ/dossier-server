root = true

[*.cs]
dotnet_diagnostic.IDE1006.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.ASP0027.severity = warning

dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal
dotnet_naming_rule.public_members_pascal.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal

dotnet_naming_style.pascal.capitalization = pascal_case
