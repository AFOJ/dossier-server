{
  "$id": "https://dossier-server.local/schemas/resume-payload.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "contact",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contact": {
      "$ref": "#/definitions/contact"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    }
  },
  "definitions": {
    "contactLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/contactLink"
          }
        }
      }
    },
    "section": {
      "oneOf": [
        {
          "$ref": "#/definitions/paragraphSection"
        },
        {
          "$ref": "#/definitions/educationSection"
        },
        {
          "$ref": "#/definitions/skillsSection"
        },
        {
          "$ref": "#/definitions/experienceSection"
        },
        {
          "$ref": "#/definitions/listSection"
        },
        {
          "$ref": "#/definitions/projectsSection"
        }
      ]
    },
    "paragraphSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "educationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "institutions"
      ],
      "properties": {
        "type": {
          "const": "education"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "institutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "degree"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "degree": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "grade": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "start_date": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "end_date": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "paragraph": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "skillsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "groups"
      ],
      "properties": {
        "type": {
          "const": "skills"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "items"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "companies"
      ],
      "properties": {
        "type": {
          "const": "experience"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "companies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "company_name",
              "roles"
            ],
            "properties": {
              "company_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "company_website": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "start_date": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "end_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "job_title",
                    "bullets"
                  ],
                  "properties": {
                    "job_title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "employment_type": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "start_date": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "end_date": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "bullets": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                        "$ref": "#/definitions/bullet"
                      }
                    }
                  },
                  "if": {
                    "required": [
                      "start_date"
                    ]
                  },
                  "then": {
                    "required": [
                      "end_date"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "bullet": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text-with-title"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "if": {
        "required": [
          "url"
        ]
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    "listSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/listItem"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "technologies",
        "bullets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "technologies": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "start_date": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "end_date": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "bullets": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/bullet"
          }
        }
      }
    },
    "projectsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "projects"
      ],
      "properties": {
        "type": {
          "const": "projects"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/project"
          }
        }
      }
    }
  }
}