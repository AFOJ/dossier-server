{
  "$id": "https://dossier-server.local/schemas/cover-letter-payload.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact",
    "body"
  ],
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact": {
      "$ref": "#/definitions/contact"
    },
    "date": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "definitions": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}